## 6. Implementation Skeleton

```python
# api_agent_tools/server.py — new entry point (stdio MCP)
import json
from typing import Any

from fastmcp import FastMCP

from api_agent.executor import execute_sql, extract_tables_from_response, truncate_for_context
from api_agent.graphql import execute_query as graphql_fetch
from api_agent.rest.client import execute_request
from api_agent.rest.schema_loader import fetch_schema_context as rest_fetch_schema

mcp = FastMCP("API Agent Tools")

# ── In-process state (single client via stdio) ──────────────────────
_state: dict[str, Any] = {
    "query_results": {},    # DuckDB tables
    "raw_schema": "",       # For search_schema
    "last_result": None,
    "base_url": "",
}


def _reset_state():
    _state["query_results"] = {}
    _state["raw_schema"] = ""
    _state["last_result"] = None
    _state["base_url"] = ""


# ── Tool 1: fetch_schema ────────────────────────────────────────────
@mcp.tool()
async def fetch_schema(
    target_url: str,
    api_type: str,
    headers: dict | None = None,
) -> str:
    """Fetch API schema. Returns compact schema for context.
    For GraphQL: runs introspection query.
    For REST: loads and parses OpenAPI 3.x spec.

    Call this FIRST before other tools.
    Use search_schema to explore parts that were truncated.
    """
    _reset_state()

    if api_type == "graphql":
        # Reuse _fetch_schema_context from graphql_agent
        # Returns compact SDL + stores raw JSON in _state
        ...
        return schema_context
    else:
        schema_ctx, spec_base_url, raw_spec_json = await rest_fetch_schema(
            target_url, headers
        )
        _state["raw_schema"] = raw_spec_json
        _state["base_url"] = spec_base_url or ""
        return schema_ctx


# ── Tool 2: search_schema ──────────────────────────────────────────
@mcp.tool()
def search_schema(
    pattern: str,
    context: int = 3,
    offset: int = 0,
) -> str:
    """Regex search on the raw schema JSON (from fetch_schema).
    Returns grep-like matches with line numbers.
    Use this to explore schema parts that were truncated in fetch_schema output.
    """
    # Reuse schema_search logic against _state["raw_schema"]
    ...


# ── Tool 3: execute_graphql ────────────────────────────────────────
@mcp.tool()
async def execute_graphql(
    query: str,
    target_url: str,
    headers: dict | None = None,
    name: str = "data",
) -> str:
    """Execute a GraphQL query. Result stored as DuckDB table for sql_query.

    - Mutations are BLOCKED (read-only)
    - Use inline values in the query, NOT $variables
    - The 'name' param sets the DuckDB table name for later sql_query calls
    """
    result = await graphql_fetch(query, None, target_url, headers)

    if result.get("success"):
        data = result.get("data", {})
        tables, schema_info = extract_tables_from_response(data, name)
        _state["query_results"].update(tables)
        stored = tables.get(name)
        if stored is not None:
            _state["last_result"] = stored

        if schema_info:
            return json.dumps({"success": True, "table": name, **schema_info}, indent=2)
        if isinstance(stored, list):
            return json.dumps({"success": True, **truncate_for_context(stored, name)}, indent=2)

    return json.dumps(result, indent=2)


# ── Tool 4: execute_rest ───────────────────────────────────────────
@mcp.tool()
async def execute_rest(
    method: str,
    path: str,
    base_url: str = "",
    path_params: dict | None = None,
    query_params: dict | None = None,
    body: dict | None = None,
    headers: dict | None = None,
    name: str = "data",
    allow_unsafe_paths: list[str] | None = None,
) -> str:
    """Execute a REST API call. Result stored as DuckDB table for sql_query.

    - POST/PUT/DELETE/PATCH blocked by default
    - Pass allow_unsafe_paths globs to permit unsafe methods
    - The 'name' param sets the DuckDB table name for later sql_query calls
    """
    url = base_url or _state.get("base_url", "")
    if not url:
        return json.dumps({"success": False, "error": "No base_url. Call fetch_schema first or pass base_url."})

    result = await execute_request(
        method, path, path_params, query_params, body,
        base_url=url,
        headers=headers,
        allow_unsafe_paths=allow_unsafe_paths or [],
    )

    if result.get("success"):
        data = result.get("data", {})
        tables, schema_info = extract_tables_from_response(data, name)
        _state["query_results"].update(tables)
        stored = tables.get(name)
        if stored is not None:
            _state["last_result"] = stored

        if schema_info:
            return json.dumps({"success": True, "table": name, **schema_info}, indent=2)
        if isinstance(stored, list):
            return json.dumps({"success": True, **truncate_for_context(stored, name)}, indent=2)

    return json.dumps(result, indent=2)


# ── Tool 5: sql_query ──────────────────────────────────────────────
@mcp.tool()
def sql_query(sql: str) -> str:
    """Run DuckDB SQL on stored API results.

    Tables are created by prior execute_graphql / execute_rest calls.
    Use list_tables to see available table names.

    Supports: SELECT, JOIN, WHERE, GROUP BY, ORDER BY, LIMIT, window functions.
    DuckDB extensions: UNNEST, list_*, struct_*, regexp_matches, etc.
    """
    if not _state["query_results"]:
        return json.dumps({"success": False, "error": "No data. Call execute_graphql or execute_rest first."})

    result = execute_sql(_state["query_results"], sql)

    if result.get("success"):
        rows = result.get("result", [])
        _state["last_result"] = rows
        if isinstance(rows, list):
            return json.dumps({"success": True, **truncate_for_context(rows, "sql_result")}, indent=2)

    return json.dumps(result, indent=2)


# ── Tool 6: list_tables ────────────────────────────────────────────
@mcp.tool()
def list_tables() -> str:
    """List available DuckDB tables from prior API calls.
    Shows table names and row counts.
    """
    tables = {}
    for name, data in _state["query_results"].items():
        tables[name] = len(data) if isinstance(data, list) else 1
    return json.dumps(tables, indent=2)


# ── Entry point ─────────────────────────────────────────────────────
if __name__ == "__main__":
    mcp.run(transport="stdio")
```

